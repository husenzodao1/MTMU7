-- Every message the phone has seen, the server's and its own on their way.
-- state: 0 on the server, 1 on its way (the clock), 2 refused (tap to retry).
CREATE TABLE message (
  id TEXT NOT NULL PRIMARY KEY,
  conversation_id TEXT NOT NULL,
  sender_id TEXT,
  sender_first_name TEXT,
  sender_last_name TEXT,
  sender_avatar_url TEXT,
  content TEXT NOT NULL,
  type TEXT NOT NULL,
  reply_to_id TEXT,
  is_pinned INTEGER NOT NULL DEFAULT 0,
  is_edited INTEGER NOT NULL DEFAULT 0,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  is_favorite INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  edited_at INTEGER,
  location_lat REAL,
  location_lng REAL,
  media_path TEXT,
  media_width INTEGER,
  media_height INTEGER,
  media_name TEXT,
  media_size INTEGER,
  media_mime TEXT,
  media_duration INTEGER,
  reactions_json TEXT NOT NULL DEFAULT '[]',
  state INTEGER NOT NULL DEFAULT 0,
  failure TEXT
);

CREATE INDEX message_by_conversation ON message(conversation_id, created_at, id);
CREATE INDEX message_by_state ON message(state, created_at);

-- The newest `limit`, oldest first for the screen.
latest:
SELECT * FROM message WHERE id IN (
  SELECT id FROM message WHERE conversation_id = :conversationId
  ORDER BY created_at DESC, id DESC LIMIT :limit
) ORDER BY created_at, id;

byId:
SELECT * FROM message WHERE id = ?;

oldest:
SELECT * FROM message WHERE conversation_id = ? AND state = 0 ORDER BY created_at, id LIMIT 1;

newestOnServer:
SELECT max(created_at) FROM message WHERE conversation_id = ? AND state = 0;

countIn:
SELECT count(*) FROM message WHERE conversation_id = ?;

pending:
SELECT * FROM message WHERE state = 1 ORDER BY created_at, id;

upsert:
INSERT OR REPLACE INTO message (
  id, conversation_id, sender_id, sender_first_name, sender_last_name, sender_avatar_url,
  content, type, reply_to_id, is_pinned, is_edited, is_deleted, is_favorite, created_at, edited_at,
  location_lat, location_lng, media_path, media_width, media_height, media_name, media_size, media_mime,
  media_duration, reactions_json, state, failure
) VALUES ?;

setState:
UPDATE message SET state = ?, failure = ? WHERE id = ?;

-- A message the sender took back.
markDeleted:
UPDATE message SET is_deleted = 1, content = '', media_path = NULL, location_lat = NULL, location_lng = NULL WHERE id = ?;

deleteById:
DELETE FROM message WHERE id = ?;

-- Older than what is on screen, beyond what the phone keeps for a chat.
trim:
DELETE FROM message WHERE conversation_id = :conversationId AND state = 0 AND id NOT IN (
  SELECT id FROM message WHERE conversation_id = :conversationId ORDER BY created_at DESC, id DESC LIMIT :keep
);

search:
SELECT * FROM message WHERE conversation_id = ? AND is_deleted = 0 AND content LIKE ('%' || ? || '%')
ORDER BY created_at DESC LIMIT 50;

clear:
DELETE FROM message;
