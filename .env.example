# Copy to .env.local for local development. Never commit real values.
# Production values are configured in the hosting provider's secret store.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used exclusively by src/lib/privileged/* (see docs/security/SECRETS.md).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000
# School shown on "/" when the request host is not mapped in school_domains.
DEFAULT_SCHOOL_SLUG=mtmu-7

# Scheduled jobs (notification dispatch). Long random string.
CRON_SECRET=generate-a-long-random-string

# Lets the sign-in page turn the login the school issued (MT10001) into the
# address Supabase signs people in by, without exposing that map to anyone
# holding the publishable key. At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Then teach the database the same value:
#   node scripts/admin/set-login-secret.mts
LOGIN_LOOKUP_SECRET=generate-a-long-random-string
