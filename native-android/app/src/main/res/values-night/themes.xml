<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mtmu7" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Mtmu7.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas_night</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mtmu7</item>
    </style>
</resources>
