{
  "name": "mtmu7-app",
  "version": "1.0.0",
  "private": true,
  "description": "The MTMU №7 portal as an app for Android and iPhone: the same site, with the phone's notifications, camera and location.",
  "scripts": {
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --iconBackgroundColor '#0b141a' --iconBackgroundColorDark '#0b141a' --splashBackgroundColor '#0b141a' --splashBackgroundColorDark '#0b141a'",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.2",
