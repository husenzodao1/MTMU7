# Copy to .env.local for local development. Never commit real values.
# Production values are configured in the hosting provider's secret store.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used exclusively by src/lib/privileged/* (see docs/security/SECRETS.md).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000
# School shown on "/" when the request host is not mapped in school_domains.
DEFAULT_SCHOOL_SLUG=mtmu-7

# Scheduled jobs (notification dispatch). Long random string.
CRON_SECRET=generate-a-long-random-string
